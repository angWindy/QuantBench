# -----------------------------------------------------------------------------
# QuantBench environment configuration
# Copy to `.env` and fill in real values (gitignored).
# -----------------------------------------------------------------------------

# --- Project -----------------------------------------------------------------
PROJECT_NAME=QuantBench
PROJECT_ROOT=/home/angwindy/Dev/QuantBench
DEFAULT_SYMBOL=NQ
DEFAULT_TIMEFRAME=1min

# --- Data --------------------------------------------------------------------
# Raw OHLCV location (CSV/Parquet) under data/raw
RAW_DATA_DIR=${PROJECT_ROOT}/data/raw
PROCESSED_DATA_DIR=${PROJECT_ROOT}/data/processed
EXTERNAL_DATA_DIR=${PROJECT_ROOT}/data/external

# --- Backtest defaults --------------------------------------------------------
INITIAL_CAPITAL=100000
FEE_BPS=2.5          # 0.025% per side
SLIPPAGE_BPS=1.0     # 0.010% per side
EXECUTION_LAG_BARS=1 # signal at t, executed at t+1

# --- Experiment tracking -----------------------------------------------------
MLFLOW_TRACKING_URI=file:${PROJECT_ROOT}/logs/mlruns
LOG_LEVEL=INFO